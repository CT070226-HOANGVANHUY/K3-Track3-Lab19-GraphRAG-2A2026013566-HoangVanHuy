# cp .env.example .env
# --- Neo4j Database (Local Docker hoặc Neo4j AuraDB) ---
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# --- Extraction & Generation LLM (Groq) ---
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenAI-compatible provider (Xah) ---
# The API key can also be supplied as XAI_API_KEY.
LLM_PROVIDER=xah
XAH_API_KEY=sk-...
XAH_BASE_URL=https://api.xah.io/v1
XAH_MODEL=mainnewnol/gpt-5.6-luna

# --- LLM-as-a-Judge (OpenAI hoặc Groq) ---
JUDGE_PROVIDER=xah
JUDGE_MODEL=mainnewnol/gpt-5.6-luna
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Hugging Face Access Token (để stream dataset HackerNoon) ---
HF_TOKEN=hf_...
